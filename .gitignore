# Dependencies - NEVER commit these
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/
frontend/build/

# Environment variables - NEVER commit secrets
.env
frontend/.env
backend/.env

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Uploads (runtime data)
backend/uploads/*
!backend/uploads/.gitkeep
